@using Authentication.web.Shared.Questions

@inject IQuestionService Questionservice
<MudGrid>
    @foreach (var prop in propositions)
    {
        <MudItem xs="1" sm="1" Class="d-flex align-center">
            <MudCheckBox @bind-Checked="@prop._chkProposition" Color="@((!prop._chkProposition) ? Color.Secondary : Color.Success)" />
        </MudItem>
        <MudItem xs="9" sm="10">
            <MudTextField @bind-Value="prop._textPropositon" Label="Proposition" Variant="Variant.Text" />
        </MudItem>
        <MudItem xs="2" sm="1" Class="d-flex align-center">
            <MudIconButton Color="Color.Secondary" Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => OnDeleteProp(prop)" />
        </MudItem>
    }
    <MudItem xs="12">
        <MudLink Color="Color.Primary" Underline="Underline.None" Style="cursor:pointer;" OnClick="OnAddProp">Ajouter une réponse</MudLink>
    </MudItem>
</MudGrid>

@if (CanSave)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="position:fixed; bottom:24px; right:24px; z-index:1000;" OnClick="SaveQuestion">Enregistrer</MudButton>
}
