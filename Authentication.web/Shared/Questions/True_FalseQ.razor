
@using Authentication.web.Shared.Questions

@inject IQuestionService Questionservice
<MudGrid>
    @foreach (var prop in propositions)
    {
        @* Colonne assez large pour les deux boutons : à xs="1" ils passaient l'un sous l'autre. *@
        <MudItem xs="4" sm="3" md="2" Class="d-flex align-center">
            <MudRadioGroup @bind-SelectedOption="@prop._chkProposition">
                <div style="display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; white-space:nowrap;">
                    <MudRadio Size="Size.Small" T="bool" Option="true" Dense="true"><span style="font-size:small; margin-right:8px">Vrai</span></MudRadio>
                    <MudRadio Size="Size.Small" T="bool" Option="false" Dense="true"><span style="font-size:small">Faux</span></MudRadio>
                </div>
            </MudRadioGroup>
        </MudItem>
        <MudItem xs="6" sm="8" md="9">
            <MudTextField @bind-Value="prop._textPropositon" Label="Proposition" Variant="Variant.Text" />
        </MudItem>
        <MudItem xs="2" sm="1" md="1" Class="d-flex align-center">
            <MudIconButton Color="Color.Secondary" Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => OnDeleteProp(prop)" />
        </MudItem>
    }
    <MudItem xs="12">
        <MudLink Color="Color.Primary" Underline="Underline.None" Style="cursor:pointer;" OnClick="OnAddProp">Ajouter une réponse</MudLink>
    </MudItem>
</MudGrid>

@if (CanSave)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="position:fixed; bottom:24px; right:24px; z-index:1000;" OnClick="SaveQuestion">Enregistrer</MudButton>
}

