<MudPaper Class="pa-3 pl-16 ma-1" Elevation="3">
    
    <MudText Typo="Typo.button"> @Question.questionText : </MudText>
    @foreach (var item in chkdItems)
        {
    <MudCheckBox @ref=item.chkboxref @bind-Checked=@item.ischecked  Label=@item.text Color="@item.color"></MudCheckBox>
        }  

</MudPaper>