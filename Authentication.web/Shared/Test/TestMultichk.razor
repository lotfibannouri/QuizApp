<MudPaper Class="pa-16 ma-2" Elevation="3">
    
    <MudText Typo="Typo.button"> @_question.questionText : </MudText>
    @foreach (var item in chkdItems)
        {
    <MudCheckBox @ref=item.chkboxref @bind-Checked=@item.ischecked  Label=@item.text Color="Color.Primary"></MudCheckBox>
        }  

</MudPaper>