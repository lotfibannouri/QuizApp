@using QuizApp.Entities.Conception_Entities.DTO.Quiz_DTO;
@inherits LayoutComponentBase
@inject IDialogService dialogService ;
@page "/QuizManagement"
@inject ISnackbar SnackbarService;

<ManagementBar TypeBar="ManagementBar.Type.QUIZ"
OnDeleteEventClicked="DeleteQuiz"
OnBindUserToQuiz="@(()=>BindEntitytoQuiz(utility.Entity.USER))" 
OnBindQuestionToQuiz="@(()=>BindEntitytoQuiz(utility.Entity.QUESTION))"               OnEditEventClicked="@(()=>EditQuiz(QuizSelected.ToList().First().Id))"
               OnDetailedQuiz="@(()=>DetailedQuiz(QuizSelected.ToList().First().Id))"
               OnUnassignQuiz="UnassignQuiz"
               ShowAssignUser="@CanAssignSelection">

           </ManagementBar>

<MudDataGrid T="ListQuizDTO" MultiSelection="true" Items="@Quiz" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
             Hideable="true" RowClick="@RowClicked" SelectedItemsChanged="@SelectedItemsChanged" SelectedItems="@QuizSelected" ondblclick="HandleRowDoubleClick" >
    <ToolBarContent>
        <MudText Typo="Typo.h6">Gestionnaire des Quiz</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ListQuizDTO" ShowInFooter="false" />
        <PropertyColumn Property="x => x.titre" Title="Titre de Quiz" />
        <PropertyColumn Property="x => x.categorieTitre" SortBy="@_sortBy" Title="Catégorie" />
        <PropertyColumn Property="x => x.duree_quiz" Title="Durée de quiz" />
        <TemplateColumn T="ListQuizDTO" Title="Questions" Sortable="false" Filterable="false">
            <CellTemplate>@context.Item.nbQuestionsRattachees / @context.Item.nbr_questions</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ListQuizDTO" Title="Statut" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (context.Item.isComplet)
                {
                    <MudChip Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Actif</MudChip>
                }
                else
                {
                    <MudTooltip Text="@($"{context.Item.nbQuestionsRattachees} question(s) rattachée(s) sur {context.Item.nbr_questions} prévue(s)")">
                        <MudChip Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Incomplet</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ListQuizDTO" Title="Assigné à" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (context.Item.isAssigne)
                {
                    <MudChip Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Lock">@context.Item.nbUtilisateursAssignes utilisateur(s)</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ListQuizDTO" />
    </PagerContent>
</MudDataGrid>

